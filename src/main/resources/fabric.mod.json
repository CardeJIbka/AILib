{
	"schemaVersion": 1,
	"id": "ailib",
	"version": "${version}",

	"name": "AI Lib",
	"description": "A library for mods that adds a local LLM, text-to-speech and speech-to-text with no cloud services. Downloads the required binaries and models by itself on first use.",
	"authors": [
		"CardeJIbka"
	],
	"contact": {
		"homepage": "https://github.com/cardejibka/ailib",
		"sources": "https://github.com/cardejibka/ailib",
		"issues": "https://github.com/cardejibka/ailib/issues"
	},

	"license": "MIT",
	"icon": "assets/ailib/icon.png",

	"environment": "*",
	"entrypoints": {
		"main": [
			"com.cardejibka.ailib.AiLibMain"
		],
		"client": [
			"com.cardejibka.ailib.client.AiLibClient"
		]
	},

	"depends": {
		"fabricloader": "${loader_dependency}",
		"minecraft": "${minecraft_dependency}",
		"java": ">=21",
		"fabric-api": "${fabric_api_dependency}"
	}
}