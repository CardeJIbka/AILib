{
	"schemaVersion": 1,
	"id": "ailib",
	"version": "${version}",

	"name": "AI Lib",
	"description": "A library for Fabric mods that adds a local LLM (llama.cpp), text-to-speech (Piper) and speech-to-text (whisper.cpp) with no cloud services. Downloads the required binaries and models by itself on first use.",
	"authors": [
		"CardeJIbka"
	],
	"contact": {
		"homepage": "https://github.com/cardejibka/ailib",
		"sources": "https://github.com/cardejibka/ailib",
		"issues": "https://github.com/cardejibka/ailib/issues"
	},

	"license": "MIT",
	"icon": "assets/ailib/icon.png",

	"environment": "*",
	"entrypoints": {
		"main": [
			"com.cardejibka.ailib.AiLibMain"
		],
		"client": [
			"com.cardejibka.ailib.client.AiLibClient"
		]
	},

	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": ">=1.21.2- <1.21.6-",
		"java": ">=21",
		"fabric-api": ">=0.102.0"
	}
}
